{
  "name": "the-isle-prime-tracker",
  "version": "0.1.0",
  "private": true,
  "author": "OpenAI Codex",
  "description": "External overlay checklist for tracking Prime Elder eligibility in The Isle.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . \"The Isle Prime Tracker\" --platform=win32 --arch=x64 --out=release --overwrite --asar --icon=assets/prime-tracker.ico",
    "bundle:desktop-setup": "powershell -ExecutionPolicy Bypass -File .\\installer\\Build-DesktopSetup.ps1",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.theisle.primetracker",
    "productName": "The Isle Prime Tracker",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "assets/**/*",
      "renderer/**/*",
      "docs/**/*",
      "README.md",
      "SECURITY.md"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/prime-tracker.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "The Isle Prime Tracker",
      "artifactName": "TheIslePrimeTracker-DesktopSetup-${version}.${ext}",
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^40.4.0",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2"
  }
}
